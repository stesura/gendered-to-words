{
  "name": "gendered-to-words",
  "version": "0.2.1",
  "description": "Convert numbers to cardinal and ordinal words, with gender support, across 40+ locales. Zero dependencies, tree-shakeable.",
  "keywords": [
    "number-to-words",
    "gendered-numbers",
    "i18n",
    "localization",
    "ordinal",
    "cardinal",
    "bigint",
    "typescript"
  ],
  "homepage": "https://github.com/stesura/gendered-to-words#readme",
  "bugs": {
    "url": "https://github.com/stesura/gendered-to-words/issues"
  },
  "license": "MIT",
  "author": "Innov-Ars",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stesura/gendered-to-words.git"
  },
  "files": [
    "dist/**/*",
    "THIRD_PARTY_LICENSES.md"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "dist/cjs/ToWords.js",
  "module": "dist/esm/ToWords.js",
  "types": "dist/types/ToWords.d.ts",
  "typesVersions": {
    "*": {
      "types": [
        "dist/types/types.d.ts"
      ],
      "core": [
        "dist/types/ToWordsCore.d.ts"
      ],
      "dist/types/*": [
        "dist/types/*"
      ],
      "*": [
        "dist/types/locales/*"
      ]
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/types/ToWords.d.ts",
        "default": "./dist/esm/ToWords.js"
      },
      "require": {
        "types": "./dist/types-cjs/ToWords.d.ts",
        "default": "./dist/cjs/ToWords.js"
      }
    },
    "./*": {
      "import": {
        "types": "./dist/types/locales/*.d.ts",
        "default": "./dist/esm/locales/*.js"
      },
      "require": {
        "types": "./dist/types-cjs/locales/*.d.ts",
        "default": "./dist/cjs/locales/*.js"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/types.d.ts",
        "default": "./dist/esm/types.js"
      },
      "require": {
        "types": "./dist/types-cjs/types.d.ts",
        "default": "./dist/cjs/types.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/types/ToWordsCore.d.ts",
        "default": "./dist/esm/ToWordsCore.js"
      },
      "require": {
        "types": "./dist/types-cjs/ToWordsCore.d.ts",
        "default": "./dist/cjs/ToWordsCore.js"
      }
    }
  },
  "scripts": {
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:pkgjson && npm run build:ctypes",
    "build:ctypes": "node -e \"const fs=require('fs');fs.cpSync('dist/types','dist/types-cjs',{recursive:true});fs.writeFileSync('dist/types-cjs/package.json',JSON.stringify({type:'commonjs'}))\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:pkgjson": "node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "clean": "node -e \"for (const d of ['dist', 'coverage']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "prepublishOnly": "npm run build",
    "lint": "oxlint --type-aware .",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest",
    "test:watch": "npm run test -- --watch",
    "checktypes": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@vitest/coverage-v8": "^4.0.18",
    "oxlint": "^1.51.0",
    "oxlint-tsgolint": "^0.16.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
